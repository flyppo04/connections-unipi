# ================================================
# CONFIGURAZIONE SERVER CONNECTIONS - LAB2526
# ================================================

# Porta TCP per connessioni client
server.tcp.port=5000

# Durata partita in secondi
server.game.duration.seconds=600

# Dimensione buffer lettura TCP
server.buffer.size=4096

# Numero thread worker pool
server.workers=16

# ================================================
# FILE DATI
# ================================================

# File utenti
server.users.file=./data/users.json

# Directory partite storiche
server.games.directory=./data/games

# File puzzle
server.puzzle.file=./puzzles.json